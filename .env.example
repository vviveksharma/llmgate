# Copy to .env — `go run .` loads this file automatically.
# Default: sends "Who are you?" to Ollama and prints the reply.
# Custom prompt: go run . "what is the capital of France?"
# HTTP gateway: go run . serve

# Ollama API base URL (ollama serve)
OLLAMA_HOST=<LOCAL MODEL ADDRESS>

# Default model when POST /v1/chat omits "model" (must already be pulled: ollama pull <name>)
OLLAMA_MODEL=<MODEL NAME>

# Address llmgate listens on
LLMGATE_ADDR=<ADDRESS>
